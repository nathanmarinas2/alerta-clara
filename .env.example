APP_ENV=development
DATABASE_URL=sqlite:///./alerta_clara.db
REDIS_URL=redis://localhost:6379/0
SERVER_PEPPER=cambia-esto-por-un-secreto-largo
FORWARDED_ALLOW_IPS=127.0.0.1
HEALTH_API_KEY=

# El MVP funciona sin OpenAI para mensajes de texto. La clave activa extracción
# multimodal y redacción asistida con salida estructurada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
# Opcional: integración de comprobación por hash con Google Safe Browsing v5.
GOOGLE_SAFE_BROWSING_API_KEY=
ENABLE_GOOGLE_SAFE_BROWSING=false
# Por privacidad las capturas no salen del servidor salvo consentimiento explícito.
ALLOW_EXTERNAL_IMAGE_ANALYSIS=false

ENABLE_NETWORK_CHECKS=true
ENABLE_THREAT_FEEDS=false
THREAT_FEED_REFRESH_SECONDS=900
THREAT_FEED_MAX_BYTES=26214400
THREAT_FEED_STALE_HOURS=6
ENABLE_QR_DECODE=true
ENABLE_LOCAL_OCR=true
OCR_MIN_CONFIDENCE=0.35
ENABLE_ML_CLASSIFIER=true
ML_CLASSIFIER_PATH=models/phishing_tfidf.joblib
ML_CLASSIFIER_HIGH_THRESHOLD=0.70
ENABLE_BROWSER_CHECKS=false
BROWSER_SCANNER_URL=http://scanner:8090
BROWSER_SCANNER_TOKEN=
BROWSER_SCAN_TIMEOUT_SECONDS=18
CAMPAIGN_WINDOW_DAYS=30
CAMPAIGN_MIN_ARTIFACT_MATCHES=2
REVIEW_API_KEY=
# Formato recomendado: analista=secreto-largo,admin=otro-secreto-largo
REVIEW_TOKENS=
RATE_LIMIT_ANALYSES_PER_MINUTE=30
RATE_LIMIT_FEEDBACK_PER_MINUTE=60
RATE_LIMIT_USE_REDIS=false
SIGNAL_TIMEOUT_SECONDS=3
BODY_RETENTION_HOURS=24
RETENTION_PURGE_INTERVAL_SECONDS=3600
RULESET_VERSION=2026.08.4
SIGNALSET_VERSION=2026.08.4
